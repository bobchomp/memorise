# Turso (cloud SQLite). Leave unset in development to use ./local.db
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Clerk (optional sign-in). Leave unset to run without accounts.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Random secret used to hash IP addresses for rate limiting, and to protect the cleanup job.
RATE_LIMIT_SECRET=change-me
CRON_SECRET=change-me
